{
  "name": "@max-ts/svelte",
  "version": "1.15.0",
  "type": "module",
  "description": "Svelte component library.",
  "author": "Tsepelev Maksim",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./reset.css": "./dist/reset.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/stories",
    "!dist/**/*.test.*",
    "!dist/.svelte-check"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package",
    "dev": "svelte-package --watch",
    "play": "vite",
    "test": "vitest",
    "lint:types": "svelte-check --tsgo --workspace ./src --tsconfig ../tsconfig.json",
    "lint:code": "biome check --write",
    "lint": "pnpm run lint:types && pnpm run lint:code",
    "release": "bumpp && pnpm publish",
    "storybook": "storybook dev -p 6006",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.10.1",
    "svelte": "^5.53.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@changesets/cli": "^2.31.1",
    "@chromatic-com/storybook": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/sveltekit": "^10.5.7",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "bumpp": "^12.2.0",
    "storybook": "^10.5.7",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lucide/svelte": "^1.31.0",
    "bits-ui": "^2.18.1"
  },
  "packageManager": "pnpm@11.21.0"
}
