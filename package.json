{
  "name": "@max-ts/svelte",
  "version": "2.3.0",
  "type": "module",
  "description": "Svelte component library.",
  "author": "Tsepelev Maksim",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./reset.css": "./dist/reset.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/stories",
    "!dist/**/*.test.*",
    "!dist/.svelte-check"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package",
    "dev": "svelte-package --watch",
    "play": "vite",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint:types": "svelte-check --tsgo --workspace ./src --tsconfig ../tsconfig.json",
    "lint:code": "biome check --write",
    "lint": "pnpm run lint:types && pnpm run lint:code",
    "release": "bumpp && pnpm publish",
    "storybook": "storybook dev -p 6006",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.10.1",
    "svelte": "^5.53.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.5.0",
    "@internationalized/date": "^3.12.4",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/sveltekit": "^10.6.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7",
    "@vitest/browser-playwright": "5.0.4",
    "bumpp": "^12.3.0",
    "storybook": "^10.6.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.4",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lucide/svelte": "^1.55.0",
    "bits-ui": "^2.19.5",
    "svelte-sonner": "^1.2.1"
  },
  "packageManager": "pnpm@12.11.2"
}
